<fxlayout>
  <page name="Lighting">
    <label>"Diffuse lighting for a GLB or native A:M model. Chain lighting nodes to combine their rigs."</label>
    <separator label="Global"/>
    <control>masterIntensity</control>
    <control>ambient</control>
    <separator label="Key Light"/>
    <control>keyColor</control>
    <control>keyIntensity</control>
    <control>keyAzimuth</control>
    <control>keyElevation</control>
    <separator label="Fill Light"/>
    <control>fillColor</control>
    <control>fillIntensity</control>
    <control>fillAzimuth</control>
    <control>fillElevation</control>
    <separator label="Rim Light"/>
    <control>rimColor</control>
    <control>rimIntensity</control>
    <control>rimAzimuth</control>
    <control>rimElevation</control>
  </page>
  <page name="Placement">
    <label>"In Positional mode, XYZ moves the whole rig in the model source's 3D space. Radius sets the distance from the rig center to each light."</label>
    <control>lightMode</control>
    <control>rigPositionX</control>
    <control>rigPositionY</control>
    <control>rigPositionZ</control>
    <control>rigRadius</control>
  </page>
</fxlayout>
